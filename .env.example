# KORE Configuration Environment Variables

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=kore_db

# NextAuth / JWT Authentication
# In production, generate an independent 32-byte secret using: openssl rand -hex 32
NEXTAUTH_SECRET=generate_secure_random_32_char_key_for_production
NEXTAUTH_URL=http://localhost:3000

# AI Engine / LLM Configuration
# Supports: ollama, openai, mock
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Optional Cloud LLM fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Search Provider Configuration
# Supports: demo (transparent curated dataset), serpapi, tavily, brave
SEARCH_PROVIDER=demo
SEARCH_API_KEY=

# Google / Gmail API Credentials (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
GMAIL_MODE=live

# Service URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
